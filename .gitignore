# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# testing
/coverage
/test-results
/playwright-report
/blob-report
/.playwright

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit these
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
!.env.local.example

# vercel
.vercel

# figma — raw API responses (~30 MB), regenerated by `npm run figma:pull`.
# The *derived* snapshot in design/ is committed on purpose: this container is
# ephemeral and the API rate limit is inherited across sessions, so a cache that
# does not survive in git is a cache that never gets used. See design/README.md.
.figma-raw/
.figma-cache.json

# typescript
*.tsbuildinfo

# editors
.idea
.vscode/*
!.vscode/extensions.json

# Per-machine Claude Code overrides — holds this machine's MCP connector ids
.claude/settings.local.json

# The places extract. 99 MB and regenerated from Overture in under a minute
# (scripts/places/extract-nl.py), so committing it would be 99 MB of history for
# a file that is never read twice — and GitHub hard-rejects a blob over 100 MB,
# so the next monthly release could turn a `git push` into a wall rather than a
# warning. Both the workflow and the README write it to the repo root.
nl-places.csv

# Python bytecode from scripts/places/.
#
# Keeps it out of the repo, and that is ALL it does — worth saying, because the
# reason it was added invites the opposite reading. `python3 -m py_compile`
# moves the unit-test count from 775 to 776, because no-service-role-key.test.ts
# walks the FILESYSTEM rather than the git index, so it counts the .pyc whether
# or not git can see it. Measured both ways. If that drift ever costs anyone
# real time, the fix is an exclusion in that test, not here.
__pycache__/
*.py[cod]

# Isolated git worktrees the Agent tool creates for a subagent. Untracked
# rather than harmless: `git status --porcelain` is queue-pickup STEP 0.5's
# gate 2, so an unignored worktree reads as a dirty tree and every hourly
# firing exits silently — the queue freezes while looking healthy, which is
# the failure shape this repo keeps paying for. It also doubles ESLint's
# output, because a worktree under the repo root is a second copy of `src/`
# for every lint and type check run here.
.claude/worktrees/
