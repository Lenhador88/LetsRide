# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
/.next/
/out/
next-env.d.ts

# The native shell's static export. `CAPACITOR_BUILD=1 npm run build` writes its
# build cache here and its output to /out/ (already ignored above) — a separate
# distDir so a web build and a Capacitor build cannot hand each other a
# half-static cache. See next.config.ts.
/.next-capacitor/

# production
/build

# testing
/coverage
/test-results
/playwright-report
/blob-report
/.playwright

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit these
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
!.env.local.example

# vercel
.vercel

# figma — raw API responses (~30 MB), regenerated by `npm run figma:pull`.
# The *derived* snapshot in design/ is committed on purpose: this container is
# ephemeral and the API rate limit is inherited across sessions, so a cache that
# does not survive in git is a cache that never gets used. See design/README.md.
.figma-raw/
.figma-cache.json

# typescript
*.tsbuildinfo

# editors
.idea
.vscode/*
!.vscode/extensions.json

# Per-machine Claude Code overrides — holds this machine's MCP connector ids
.claude/settings.local.json
