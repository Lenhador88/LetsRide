{
  "name": "letsride",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:native": "CAPACITOR_BUILD=1 next build && node scripts/native/check-export.mjs",
    "release:check": "node scripts/native/assert-release-bundle.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "./supabase/tests/run.sh",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "functions:check": "deno check supabase/functions/*/index.ts",
    "figma": "node scripts/figma/query.mjs",
    "figma:pull": "node scripts/figma/pull.mjs",
    "figma:extract": "node scripts/figma/extract.mjs",
    "figma:icons": "node scripts/figma/icons.mjs",
    "figma:check": "node scripts/figma/check.mjs",
    "storage:sweep": "node scripts/storage/sweep-orphans.mjs",
    "figma:components": "node scripts/figma/components.mjs",
    "openspec": "openspec",
    "walk": "node scripts/walk.mjs",
    "db:drift": "node scripts/db/check-migration-drift.mjs",
    "db:seed:check": "./scripts/db/check-seed.sh",
    "docs:check": "node scripts/docs/check.mjs",
    "docs:check:cheap": "node scripts/docs/check.mjs --cheap",
    "figma:measure": "node scripts/figma/measure-icons.mjs",
    "logs:errors": "node scripts/db/logs-errors.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.0",
    "@capacitor/core": "8.5.0",
    "@sentry/capacitor": "4.3.0",
    "@sentry/react": "10.69.0",
    "@supabase/supabase-js": "2.111.0",
    "clsx": "^2.1.1",
    "next": "16.2.9",
    "posthog-js": "1.422.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/cli": "8.5.0",
    "@capacitor/ios": "8.5.0",
    "@fission-ai/openspec": "^1.7.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
